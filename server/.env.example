# QuickBet server (devnet only). Copy to .env, or run: npm run setup-devnet -w server
PORT=8787
RPC_URL=https://api.devnet.solana.com
# Deployed program ID (devnet). Set after `anchor deploy --provider.cluster devnet`.
PROGRAM_ID=
# Demo USDC mint, written by setup-devnet
DEMO_MINT=
# Keypair files (gitignored). On a host, use TREASURY_SECRET / MINT_AUTHORITY_SECRET (JSON arrays) instead.
TREASURY_KEYPAIR=keys/treasury.json
MINT_AUTHORITY_KEYPAIR=keys/mint-authority.json
# Comma-separated web origins allowed to call the API ("*" for the local fallback)
ALLOWED_ORIGIN=*
FAUCET_SOL_THRESHOLD=0.03
FAUCET_SOL_AMOUNT=0.05
FAUCET_USDC_AMOUNT=250
